{
  "name": "haleem-income-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd packages/shared build && bun run --cwd apps/web build",
    "lint": "bun run --cwd apps/api lint && bun run --cwd apps/web lint"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "mongoose": "^9.8.1",
    "resend": "^6.18.0"
  }
}
